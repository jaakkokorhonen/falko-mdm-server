{
  "ruleName": "Personal Data Classification Rule",
  "displayName": "Personal Data - External Block",
  "description": "Blocks external sharing of files containing personal data or marked with the Personal Data label.",
  "severity": "HIGH",
  "scanSources": [
    "DRIVE_SHARE"
  ],
  "conditions": [
    {
      "orConditions": [
        {
          "labelCondition": {
            "labelId": "labels/personal_data_label_id",
            "operator": "EXISTS"
          }
        },
        {
          "contentCondition": {
            "detectorType": "FINNISH_SOCIAL_SECURITY_NUMBER",
            "operator": "CONTAINS"
          }
        },
        {
          "contentCondition": {
            "detectorType": "CREDIT_CARD_NUMBER",
            "operator": "CONTAINS"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "blockAction": {
        "customErrorMessage": "This file contains personal data or is classified as Personal Data. External sharing is blocked for data privacy compliance."
      }
    },
    {
      "auditAction": {
        "sendAlert": true
      }
    }
  ]
}
