{
  "ruleName": "Customer Confidential Classification Rule",
  "displayName": "Customer Confidential - Allowlist Sharing Only",
  "description": "Restricts sharing to approved partner domains only for Customer Confidential files.",
  "severity": "HIGH",
  "scanSources": [
    "DRIVE_SHARE"
  ],
  "conditions": [
    {
      "labelCondition": {
        "labelId": "labels/customer_confidential_label_id",
        "operator": "EXISTS"
      }
    }
  ],
  "actions": [
    {
      "blockAction": {
        "customErrorMessage": "This file is marked as Customer Confidential. Sharing is restricted to approved partner domains only.",
        "exceptionDomains": [
          "approved-customer.com",
          "falko.fi"
        ]
      }
    },
    {
      "auditAction": {
        "sendAlert": true
      }
    }
  ]
}
